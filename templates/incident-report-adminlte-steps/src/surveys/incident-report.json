            },
            {
              "value": "hazard",
              "text": "Unsafe condition or hazard"
            },
            {
              "value": "equipment",
              "text": "Equipment-related incident"
            },
            {
              "value": "violence",
              "text": "Threat, harassment, or violence"
            },
            {
              "value": "property",
              "text": "Property damage"
            },
            {
              "value": "other",
              "text": "Other"
            }
          ]
        },
        {
          "type": "radiogroup",
          "name": "workplace_injury",
