{
  "name": "adminlte-surveyjs-templates",
  "private": true,
  "version": "1.0.0",
  "description": "AdminLTE 4 templates whose forms are built with the SurveyJS Form Library.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "install:all": "node scripts/each-template.mjs ci",
    "lint": "node scripts/each-template.mjs run lint",
    "test": "node scripts/each-template.mjs run test",
    "build": "node scripts/each-template.mjs run build",
    "test:e2e": "node scripts/each-template.mjs run test:e2e",
    "build:site": "node scripts/build-site.mjs",
    "serve:site": "node scripts/serve-site.mjs",
    "test:site": "npm run build:site && playwright test",
    "check:standalone": "node scripts/check-standalone.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
